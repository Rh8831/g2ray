worker_processes auto;
pid /run/nginx.pid;

events {
  worker_connections 4096;
}

http {
  access_log /dev/stdout;
  error_log /dev/stderr info;

  sendfile on;
  tcp_nopush on;
  tcp_nodelay on;
  keepalive_timeout 75s;
  types_hash_max_size 2048;
  client_max_body_size 0;

  # XHTTP uses long-lived HTTP request/response streams. Disable buffering so
  # the Codespace behaves as an edge relay instead of a second proxy server.
  proxy_buffering off;
  proxy_request_buffering off;
  proxy_http_version 1.1;
  proxy_connect_timeout 30s;
  proxy_send_timeout 1h;
  proxy_read_timeout 1h;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  server {
    listen ${G2RAY_LISTEN_PORT};
    server_name _;

    location / {
      proxy_pass ${G2RAY_UPSTREAM_URL};
      proxy_ssl_server_name on;
      proxy_ssl_name ${G2RAY_UPSTREAM_TLS_NAME};

      proxy_set_header Host ${G2RAY_UPSTREAM_HOST_HEADER};
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
    }
  }
}
